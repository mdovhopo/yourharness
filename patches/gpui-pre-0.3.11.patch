 struct WrapScratch {
     glyph_indices: FxHashSet<usize>,
     break_indices: Vec<usize>,
+}
+
+// YourHarness patch: keep recently evicted shaped lines warm across frames (bounded)
+// so fast scrolling and switching between huge threads do not re-shape the same lines
+// through CoreText every time they leave the viewport for a frame.
+const MAX_WARM_ENTRIES: usize = 4_096;
+
+struct WarmCache<V> {
+    map: FxHashMap<Arc<CacheKey>, V>,
+    order: std::collections::VecDeque<Arc<CacheKey>>,
+}
+
+impl<V> Default for WarmCache<V> {
+    fn default() -> Self {
+        Self {
+            map: FxHashMap::default(),
+            order: std::collections::VecDeque::new(),
+        }
+    }
+}
+
+impl<V> WarmCache<V> {
+    fn insert(&mut self, key: Arc<CacheKey>, value: V) {
+        if let Some(slot) = self.map.get_mut(&key) {
+            *slot = value;
+            return;
+        }
+        while self.map.len() >= MAX_WARM_ENTRIES {
+            let Some(oldest) = self.order.pop_front() else {
+                break;
+            };
+            self.map.remove(&oldest);
+        }
+        if self.order.len() > MAX_WARM_ENTRIES * 2 {
+            self.order.retain(|k| self.map.contains_key(k));
+        }
+        self.order.push_back(key.clone());
+        self.map.insert(key, value);
+    }
+
+    fn remove_entry(&mut self, key: &dyn AsCacheKeyRef) -> Option<(Arc<CacheKey>, V)> {
+        self.map.remove_entry(key)
+    }
 }
 
