+
+/// YourHarness patch: a drawable's pixels (BGRA) as a PNG.
+fn write_snapshot(texture: &metal::TextureRef, path: &std::path::Path) {
+    let (width, height) = (texture.width() as u32, texture.height() as u32);
+    let mut bytes = vec![0u8; (width * height * 4) as usize];
+    texture.get_bytes(
+        bytes.as_mut_ptr() as *mut c_void,
+        (width * 4) as u64,
+        metal::MTLRegion::new_2d(0, 0, width as u64, height as u64),
+        0,
+    );
+    for pixel in bytes.chunks_exact_mut(4) {
+        pixel.swap(0, 2);
+        pixel[3] = 255;
+    }
+    match image::RgbaImage::from_raw(width, height, bytes).map(|img| img.save(path)) {
+        Some(Ok(())) => eprintln!("SNAPSHOT {}", path.display()),
+        other => eprintln!("snapshot failed: {:?}", other.map(|r| r.err())),
+    }
 }
